# Build-time variable (Vite bakes it into the bundle).
# Local dev: this default is what the app uses even if the variable is unset.
# Vercel: set it to your Render backend instead, including the /api suffix, e.g.
#   VITE_API_URL=https://iscc-mass-balancer-api.onrender.com/api
VITE_API_URL=http://localhost:4000/api
