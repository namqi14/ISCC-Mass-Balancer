# Copy this file to .env and adjust as needed.

# XAMPP MySQL default: root user, no password, port 3306.
DATABASE_URL="mysql://root:@localhost:3306/mass_balancer"

# Change this to a long random string in any real deployment.
JWT_SECRET="dev-only-change-me-please-1234567890"
JWT_EXPIRES_IN="12h"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# AES-256-GCM key for application-level field encryption. Must base64-decode
# to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY="replace-with-a-generated-32-byte-base64-key"

# OAuth2/OIDC SSO (optional -- /api/auth/oauth/login and /callback return
# 501 OAUTH_NOT_CONFIGURED until these are set to a real registered OAuth
# application's details with an actual OIDC provider).
# OIDC_ISSUER_URL="https://accounts.google.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_REDIRECT_URI="http://localhost:4000/api/auth/oauth/callback"

# Set to a real connection string to switch the cache (lib/cache.ts) from
# its in-memory default to a real Redis instance, once one exists.
# REDIS_URL="redis://localhost:6379"

# Load balancing via Node's cluster module. Off by default -- only exercise
# via `npm run build && npm start`, not `npm run dev` (tsx watch and
# cluster.fork() don't mix). WEB_CONCURRENCY overrides the worker count
# (defaults to the number of CPU cores).
# CLUSTER_ENABLED="true"
# WEB_CONCURRENCY=4
