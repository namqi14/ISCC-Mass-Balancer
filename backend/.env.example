# Copy this file to .env and adjust as needed.

# ---------------------------------------------------------------------------
# Database: PostgreSQL (Supabase in production, embedded Postgres locally)
# ---------------------------------------------------------------------------
# LOCAL: run `npm run db:dev` in its own terminal, then use this for BOTH:
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mass_balancer"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/mass_balancer"
#
# PRODUCTION (Supabase) -- Dashboard > Connect. They differ on purpose:
#   DATABASE_URL = the pooled "Transaction" connection (port 6543), used by the app:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
#   DIRECT_URL = the "Session" connection (port 5432), used only by `prisma migrate`:
#     postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (Use the pooler host for both: the plain db.<ref>.supabase.co host is IPv6-only
# and Render can't reach it on the free plan.)

# Change this to a long random string in any real deployment.
JWT_SECRET="dev-only-change-me-please-1234567890"
JWT_EXPIRES_IN="12h"

PORT=4000
# The ONE origin allowed to call this API from a browser. Production: your Vercel URL.
CORS_ORIGIN="http://localhost:5173"

# Number of reverse-proxy hops in front of the app. Render: 1. Leave unset locally.
# (Without it, rate limiting sees every user as the proxy's single address.)
# TRUST_PROXY=1

# AES-256-GCM key for application-level field encryption. Must base64-decode
# to exactly 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up: losing it makes already-encrypted fields unreadable.
FIELD_ENCRYPTION_KEY="replace-with-a-generated-32-byte-base64-key"

# Supabase Storage (company logos, ISCC certificate PDFs). Use the service_role
# key -- server-side only, never in the frontend. Create the buckets with
# `npm run storage:setup`.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="replace-with-the-service-role-key"

# Only for `npm run seed` on a PUBLIC deployment: the password given to the demo
# accounts. Unset = the well-known demo password (fine locally, not on the internet).
# SEED_PASSWORD=""

# OAuth2/OIDC SSO (optional -- /api/auth/oauth/login and /callback return
# 501 OAUTH_NOT_CONFIGURED until these are set to a real registered OAuth
# application's details with an actual OIDC provider).
# OIDC_ISSUER_URL="https://accounts.google.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_REDIRECT_URI="http://localhost:4000/api/auth/oauth/callback"

# Set to a real connection string to switch the cache (lib/cache.ts) from
# its in-memory default to a real Redis instance, once one exists.
# REDIS_URL="redis://localhost:6379"

# Load balancing via Node's cluster module. Off by default -- only exercise
# via `npm run build && npm start`, not `npm run dev` (tsx watch and
# cluster.fork() don't mix). WEB_CONCURRENCY overrides the worker count
# (defaults to the number of CPU cores). Not useful on Render's free plan.
# CLUSTER_ENABLED="true"
# WEB_CONCURRENCY=4
